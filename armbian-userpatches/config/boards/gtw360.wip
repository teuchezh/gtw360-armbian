# Geniatech GTW360. Preserve the installed vendor U-Boot.
BOARD_NAME="Geniatech GTW360"
BOARD_VENDOR="geniatech"
BOARDFAMILY="imx6"
KERNEL_TARGET="current"
BOOTCONFIG="none"
BOOTSCRIPT=""
BOOTENV_FILE=""
BOOTSIZE="256"
BOOTFS_TYPE="fat"
OFFSET="4"
SERIALCON="ttymxc0"
CPUMIN="198000"
CPUMAX="792000"
ENABLE_EXTENSIONS="${ENABLE_EXTENSIONS:+${ENABLE_EXTENSIONS},}gtw360"
PACKAGE_LIST_BOARD="usbutils v4l-utils python3-venv device-tree-compiler"
EXTRAWIFI="no"
